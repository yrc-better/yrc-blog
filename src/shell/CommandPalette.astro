---
import { listFeed, type EntryKind } from "../catalog/entries.ts";
import { route } from "../shared/url.ts";

type Command = {
  id: string;
  kind: EntryKind | "page";
  title: string;
  hint: string;
  href: string;
};

const KIND_LABEL: Record<Command["kind"], string> = {
  page: "Go to",
  paper: "Paper",
  post: "Post",
  project: "Project",
};

const pages: Command[] = [
  { id: "page-home", kind: "page", title: "Home", hint: "~/", href: route() },
  { id: "page-papers", kind: "page", title: "Papers", hint: "~/papers", href: route("papers") },
  { id: "page-projects", kind: "page", title: "Projects", hint: "~/projects", href: route("projects") },
  { id: "page-posts", kind: "page", title: "Blog", hint: "~/posts", href: route("posts") },
];

const entries: Command[] = (await listFeed()).map((item) => ({
  id: `${item.kind}-${item.id}`,
  kind: item.kind,
  title: item.title,
  hint: item.description,
  href: item.href,
}));

const commands = [...pages, ...entries];
---

<dialog id="command-palette" class="cmd" aria-label="Command palette">
  <div class="cmd__box">
    <div class="cmd__bar" aria-hidden="true">
      <span>NETRUNNER://SEARCH</span>
      <span>{commands.length} NODES</span>
    </div>
    <label class="cmd__prompt">
      <span class="cmd__caret" aria-hidden="true">&gt;</span>
      <span class="cy-visually-hidden">Search the site</span>
      <input
        class="cmd__input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="command-list"
        aria-autocomplete="list"
        placeholder="jack in: papers, posts, projects…"
        autocomplete="off"
        spellcheck="false"
        data-command-input
      />
    </label>
    <ul id="command-list" class="cmd__list" role="listbox" aria-label="Results" data-command-list>
      {
        commands.map((command) => (
          <li
            id={`cmd-${command.id}`}
            class={`cmd__opt cmd__opt--${command.kind}`}
            role="option"
            aria-selected="false"
            data-href={command.href}
            data-search={`${command.title} ${command.hint} ${KIND_LABEL[command.kind]}`.toLowerCase()}
          >
            <span class="cmd__kind">{KIND_LABEL[command.kind]}</span>
            <span class="cmd__title">{command.title}</span>
            <span class="cmd__hint">{command.hint}</span>
          </li>
        ))
      }
    </ul>
    <p class="cmd__empty" role="status" data-command-empty hidden>NO SIGNAL — nothing matches that query.</p>
    <p class="cmd__keys" aria-hidden="true"><kbd>↑↓</kbd> navigate <kbd>↵</kbd> open <kbd>esc</kbd> close</p>
  </div>
</dialog>

<script>
  import "./command-palette.client.ts";
</script>

<style>
  .cmd {
    width: min(640px, calc(100vw - 24px));
    max-height: min(560px, calc(100vh - 80px));
    margin: 12vh auto 0;
    padding: 0;
    color: var(--cy-text);
    background: var(--cy-panel-solid);
    border: 1px solid var(--cy-cyan);
    box-shadow: var(--cy-glow-cyan);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
  }

  .cmd::backdrop {
    background: var(--cy-shadow);
    backdrop-filter: blur(3px);
  }

  .cmd[open] {
    animation: cmd-in var(--cy-fast) var(--cy-ease);
  }

  .cmd__box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .cmd__bar {
    display: flex;
    justify-content: space-between;
    padding: 6px 16px;
    font-family: var(--cy-font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--cy-on-accent);
    background: var(--cy-cyan);
  }

  .cmd__prompt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--cy-line);
  }

  .cmd__caret {
    font-family: var(--cy-font-mono);
    color: var(--cy-yellow);
    animation: caret 1s steps(1) infinite;
  }

  .cmd__input {
    flex: 1;
    min-width: 0;
    font-family: var(--cy-font-mono);
    font-size: 16px;
    color: var(--cy-text);
    background: none;
    border: 0;
    outline: none;
    caret-color: var(--cy-yellow);
  }

  .cmd__input::placeholder {
    color: var(--cy-text-faint);
  }

  .cmd__list {
    flex: 1;
    margin: 0;
    padding: 6px;
    overflow-y: auto;
    list-style: none;
  }

  .cmd__opt {
    position: relative;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 2px 12px;
    padding: 10px 36px 10px 12px;
    cursor: pointer;
    border-left: 2px solid var(--cy-transparent);
  }

  .cmd__opt[hidden] {
    display: none;
  }

  .cmd__opt:hover {
    background: var(--cy-panel-hover);
  }

  .cmd__opt[aria-selected="true"] {
    background: linear-gradient(90deg, var(--cy-cyan-soft), var(--cy-transparent));
    border-left-color: var(--cy-cyan);
    box-shadow: inset 0 0 0 1px var(--cy-cyan-line);
  }

  .cmd__opt[aria-selected="true"] .cmd__title {
    color: var(--cy-cyan);
    text-shadow: var(--cy-text-glow-cyan);
  }

  .cmd__opt[aria-selected="true"]::after {
    content: "↵";
    content: "↵" / "";
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--cy-font-mono);
    color: var(--cy-yellow);
  }

  .cmd__kind {
    grid-row: span 2;
    align-self: center;
    font-family: var(--cy-font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cy-text-faint);
  }

  .cmd__opt--paper .cmd__kind {
    color: var(--cy-kind-paper);
  }

  .cmd__opt--post .cmd__kind {
    color: var(--cy-kind-post);
  }

  .cmd__opt--project .cmd__kind {
    color: var(--cy-kind-project);
  }

  .cmd__title {
    font-weight: 600;
  }

  .cmd__hint {
    overflow: hidden;
    font-size: 12px;
    color: var(--cy-text-dim);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cmd__empty {
    margin: 0;
    padding: 24px 16px;
    font-family: var(--cy-font-mono);
    font-size: 13px;
    color: var(--cy-magenta);
  }

  .cmd__keys {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0;
    padding: 10px 16px;
    font-family: var(--cy-font-mono);
    font-size: 11px;
    color: var(--cy-text-faint);
    border-top: 1px solid var(--cy-line);
  }

  .cmd__keys kbd {
    padding: 0 5px;
    font-family: inherit;
    color: var(--cy-yellow);
    border: 1px solid var(--cy-line-strong);
  }

  @keyframes cmd-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
</style>

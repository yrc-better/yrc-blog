---
import Icon, { type IconName } from "./Icon.astro";

type Props = {
  href: string;
  variant?: "solid" | "ghost";
  tone?: "yellow" | "cyan" | "magenta";
  icon?: IconName;
  external?: boolean;
  label?: string;
};

const { href, variant = "solid", tone = "yellow", icon, external = false, label } = Astro.props;
---

<a
  class:list={["btn", `btn--${variant}`, `btn--${tone}`]}
  href={href}
  aria-label={label}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {icon && <Icon name={icon} size={16} />}
  <span class="btn__text"><slot /></span>
  <span class="btn__tail" aria-hidden="true">{external ? "↗" : "→"}</span>
</a>

<style>
  .btn {
    --btn-accent: var(--cy-yellow);
    --btn-glow: var(--cy-glow-yellow);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px 12px 18px;
    font-family: var(--cy-font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    transition:
      transform var(--cy-fast) var(--cy-ease),
      box-shadow var(--cy-fast) var(--cy-ease),
      background var(--cy-fast) var(--cy-ease),
      color var(--cy-fast) var(--cy-ease);
  }

  .btn--cyan {
    --btn-accent: var(--cy-cyan);
    --btn-glow: var(--cy-glow-cyan);
  }

  .btn--magenta {
    --btn-accent: var(--cy-magenta);
    --btn-glow: var(--cy-glow-magenta);
  }

  .btn--solid {
    color: var(--cy-on-accent);
    background: var(--btn-accent);
  }

  .btn--ghost {
    color: var(--btn-accent);
    background: var(--cy-transparent);
    box-shadow: inset 0 0 0 1px var(--btn-accent);
  }

  .btn:hover,
  .btn:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: var(--btn-glow);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    color: var(--cy-on-accent);
    background: var(--btn-accent);
  }

  .btn__tail {
    transition: transform var(--cy-fast) var(--cy-ease);
  }

  .btn:hover .btn__tail {
    transform: translateX(4px);
  }
</style>

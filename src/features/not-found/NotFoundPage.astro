---
import BaseLayout from "../../shell/BaseLayout.astro";
import GlitchText from "../../primitives/GlitchText.astro";
import NeonButton from "../../primitives/NeonButton.astro";
import { route } from "../../shared/url.ts";
---

<BaseLayout title="Signal lost" description="This page does not exist.">
  <section class="lost cy-container" aria-labelledby="lost-title">
    <p class="lost__code" aria-hidden="true">ERR_404</p>
    <GlitchText as="h1" size="page" text="Signal lost" id="lost-title" />
    <p class="lost__text">The node you requested is not on this network. It may have moved, or never existed.</p>
    <pre class="lost__trace" aria-hidden="true">&gt; trace --route <span class="lost__path" data-requested-path>unknown</span>
  hop 01 ........ gateway                OK
  hop 02 ........ <span class="lost__path" data-requested-path>unknown</span>  <span class="lost__bad">NO ROUTE</span></pre>
    <NeonButton href={route()} tone="cyan" icon="arrow">Return home</NeonButton>
  </section>
</BaseLayout>

<script>
  import "./not-found.client.ts";
</script>

<style>
  .lost {
    padding: 12vh 0 4vh;
  }

  .lost__code {
    margin: 0 0 8px;
    font-family: var(--cy-font-display);
    font-size: min(180px, calc((100vw - 48px) / 7.4));
    font-weight: 900;
    line-height: 1;
    color: var(--cy-transparent);
    -webkit-text-stroke: 1px var(--cy-magenta);
    text-shadow: var(--cy-text-glow-magenta);
  }

  .lost__text {
    max-width: 52ch;
    margin: 18px 0 26px;
    color: var(--cy-text-dim);
  }

  .lost__trace {
    max-width: 560px;
    margin: 0 0 32px;
    padding: 16px 18px;
    overflow-x: auto;
    font-family: var(--cy-font-mono);
    font-size: 12px;
    line-height: 1.9;
    color: var(--cy-text-faint);
    background: var(--cy-panel);
    border-left: 2px solid var(--cy-magenta);
  }

  .lost__path {
    color: var(--cy-text-dim);
  }

  .lost__bad {
    color: var(--cy-magenta);
  }
</style>

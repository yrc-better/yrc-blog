---
import GlitchText from "../../primitives/GlitchText.astro";
import NeonButton from "../../primitives/NeonButton.astro";
import Icon from "../../primitives/Icon.astro";
import { SITE } from "../../shared/site.ts";
import { route } from "../../shared/url.ts";
import type { EntryKind } from "../../catalog/entries.ts";
import IdCard from "./IdCard.astro";

type Props = {
  counts: Record<EntryKind, number>;
};

const { counts } = Astro.props;
const pad = (n: number): string => String(n).padStart(2, "0");

const bootLog = [
  { cmd: "jack_in --user synn", result: "OK" },
  { cmd: "mount ~/papers", result: `[${pad(counts.paper)}] OK` },
  { cmd: "mount ~/projects", result: `[${pad(counts.project)}] OK` },
  { cmd: "mount ~/posts", result: `[${pad(counts.post)}] OK` },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__floor" aria-hidden="true"></div>
  <div class="hero__rain" aria-hidden="true">
    {Array.from({ length: 9 }, (_, i) => <span style={`--i:${i}`} />)}
  </div>

  <div class="hero__inner cy-container">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__tag">SYS.ONLINE</span>
        <span class="hero__type" data-typeout={SITE.signal}>{SITE.signal}</span>
      </p>

      <GlitchText as="h1" size="hero" text={SITE.name} id="hero-title" />

      <p class="hero__sub">
        <mark>Study notes</mark>, side projects, and bits of everyday life.
      </p>

      <ol class="hero__boot" aria-hidden="true">
        {
          bootLog.map((line, i) => (
            <li style={`--d:${i}`}>
              <span class="hero__prompt">&gt;</span> {line.cmd}
              <span class="hero__dots" />
              <span class="hero__ok">{line.result}</span>
            </li>
          ))
        }
      </ol>

      <div class="hero__cta">
        <NeonButton href={route("papers")} icon="paper">Read papers</NeonButton>
        <button
          class="hero__term"
          type="button"
          data-command-open
          aria-label="Open terminal"
          aria-keyshortcuts="Meta+K Control+K /"
          aria-haspopup="dialog"
          aria-controls="command-palette"
        >
          <Icon name="terminal" size={16} />
          Open terminal
          <kbd>⌘K</kbd>
        </button>
      </div>
    </div>

    <IdCard />
  </div>
</section>

<script>
  import "./home.client.ts";
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 9vh, 104px) 0 clamp(64px, 12vh, 132px);
    border-bottom: 1px solid var(--cy-line);
  }

  .hero__floor {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: -10%;
    height: 55%;
    background-image:
      linear-gradient(var(--cy-grid-floor) 1px, var(--cy-transparent) 1px),
      linear-gradient(90deg, var(--cy-grid-floor) 1px, var(--cy-transparent) 1px);
    background-size: 64px 64px;
    transform: perspective(420px) rotateX(62deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(to top, var(--cy-void) 10%, var(--cy-transparent) 85%);
    opacity: 0.45;
    animation: floor 2.8s linear infinite;
  }

  .hero__rain span {
    position: absolute;
    top: -40%;
    left: calc(6% + var(--i) * 11%);
    width: 1px;
    height: 40%;
    background: linear-gradient(to bottom, var(--cy-transparent), var(--cy-cyan));
    opacity: 0.35;
    animation: rain calc(5s + var(--i) * 0.7s) linear infinite;
    animation-delay: calc(var(--i) * -1.3s);
  }

  .hero__rain span:nth-child(3n) {
    background: linear-gradient(to bottom, var(--cy-transparent), var(--cy-magenta));
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.9fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 22px;
    font-family: var(--cy-font-mono);
    font-size: 13px;
    letter-spacing: 0.22em;
    color: var(--cy-cyan);
    text-shadow: var(--cy-text-glow-cyan);
  }

  .hero__tag {
    padding: 2px 8px;
    font-size: 10px;
    color: var(--cy-on-accent);
    background: var(--cy-magenta);
    text-shadow: none;
  }

  .hero__type {
    min-height: 1.6em;
  }

  .hero__type::after {
    content: "▌";
    margin-left: 2px;
    color: var(--cy-yellow);
    animation: caret 1s steps(1) infinite;
  }

  .hero__sub {
    max-width: 34ch;
    margin: 22px 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--cy-text-dim);
  }

  .hero__sub mark {
    padding: 0 6px;
    color: var(--cy-on-accent);
    background: var(--cy-yellow);
  }

  .hero__boot {
    max-width: 440px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--cy-font-mono);
    font-size: 12px;
    line-height: 2;
    color: var(--cy-text-faint);
  }

  .hero__boot li {
    display: flex;
    gap: 8px;
    opacity: 0;
    animation: boot 0.3s var(--cy-ease) forwards;
    animation-delay: calc(0.4s + var(--d) * 0.28s);
  }

  .hero__prompt {
    color: var(--cy-magenta);
  }

  .hero__dots {
    flex: 1;
    border-bottom: 1px dotted var(--cy-line-strong);
    margin-bottom: 0.6em;
  }

  .hero__ok {
    color: var(--cy-green);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .hero__term {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    font-family: var(--cy-font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cy-cyan);
    background: var(--cy-transparent);
    border: 1px solid var(--cy-cyan);
    cursor: pointer;
    transition:
      box-shadow var(--cy-fast) var(--cy-ease),
      background var(--cy-fast) var(--cy-ease);
  }

  .hero__term:hover {
    background: var(--cy-cyan-soft);
    box-shadow: var(--cy-glow-cyan);
  }

  .hero__term kbd {
    padding: 0 5px;
    font-family: inherit;
    font-size: 10px;
    color: var(--cy-yellow);
    border: 1px solid var(--cy-line-strong);
  }

  @keyframes floor {
    to {
      background-position: 0 64px;
    }
  }

  @keyframes rain {
    to {
      transform: translateY(380%);
    }
  }

  @keyframes boot {
    to {
      opacity: 1;
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from "../../shell/BaseLayout.astro";
import SectionHeading from "../../primitives/SectionHeading.astro";
import { formatDate, isoDate } from "../../shared/dates.ts";
import { listPosts, postHref, POST_CATEGORIES, type Post } from "../../catalog/entries.ts";
import { readingMinutes } from "../../catalog/reading-time.ts";

const posts = await listPosts();
const groups = (Object.keys(POST_CATEGORIES) as Post["data"]["category"][])
  .map((category) => ({
    category,
    ...POST_CATEGORIES[category],
    posts: posts.filter((post) => post.data.category === category),
  }))
  .filter((group) => group.posts.length > 0);
---

<BaseLayout title="Blog" description="Study notes and life essays by synn." active="posts">
  <div class="cy-container">
    <SectionHeading index="03 / posts" title="Blog" caption="Everything I have written, in one place." count={posts.length} />

    {
      groups.map((group) => (
        <section class="group" aria-labelledby={`group-${group.category}`}>
          <h2 class="group__title" id={`group-${group.category}`}>
            {group.label}
            <span class="group__zh">{group.zh}</span>
          </h2>
          <ol class="group__list">
            {group.posts.map((post) => (
              <li class="row">
                <time class="row__date" datetime={isoDate(post.data.date)}>
                  {formatDate(post.data.date)}
                </time>
                <div class="row__text">
                  <h3 class="row__title">
                    <a href={postHref(post)}>{post.data.title}</a>
                  </h3>
                  <p class="row__desc">{post.data.description}</p>
                </div>
                <span class="row__time">{readingMinutes(post.body)} min</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .group {
    margin-top: 28px;
  }

  .group__title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    padding-bottom: 10px;
    font-family: var(--cy-font-display);
    font-size: 18px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cy-cyan);
    border-bottom: 1px solid var(--cy-cyan-line);
  }

  .group__zh {
    font-family: var(--cy-font-mono);
    font-size: 12px;
    color: var(--cy-text-faint);
  }

  .group__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 18px 10px;
    border-bottom: 1px solid var(--cy-line);
    transition: background var(--cy-fast) var(--cy-ease);
  }

  .row:hover {
    background: linear-gradient(90deg, var(--cy-cyan-soft), var(--cy-transparent));
  }

  .row__date,
  .row__time {
    font-family: var(--cy-font-mono);
    font-size: 12px;
    color: var(--cy-text-faint);
  }

  .row__title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  .row__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row:hover .row__title {
    color: var(--cy-cyan);
    text-shadow: var(--cy-text-glow-cyan);
  }

  .row__desc {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--cy-text-dim);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }

    .row__text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

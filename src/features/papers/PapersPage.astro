---
import BaseLayout from "../../shell/BaseLayout.astro";
import SectionHeading from "../../primitives/SectionHeading.astro";
import HudPanel from "../../primitives/HudPanel.astro";
import Chip from "../../primitives/Chip.astro";
import { formatDate, isoDate } from "../../shared/dates.ts";
import { listPapers, paperHref } from "../../catalog/entries.ts";
import { readingMinutes } from "../../catalog/reading-time.ts";

const papers = await listPapers();
---

<BaseLayout title="Papers" description="AI paper reading notes by synn." active="papers">
  <div class="cy-container">
    <SectionHeading index="01 / papers" title="Papers" caption="这里收录我对人工智能论文的精读笔记。" count={papers.length} />

    <ol class="papers">
      {
        papers.map((paper, i) => (
          <li>
            <HudPanel as="article" tone="yellow" interactive label={`PAPER ${String(i + 1).padStart(2, "0")}`}>
              <div class="paper">
                <p class="paper__meta">
                  <time datetime={isoDate(paper.data.date)}>{formatDate(paper.data.date)}</time>
                  <span>· {readingMinutes(paper.body)} min read</span>
                </p>
                <h2 class="paper__title">
                  <a href={paperHref(paper)}>{paper.data.title}</a>
                </h2>
                <p class="paper__subtitle">{paper.data.subtitle}</p>
                <p class="paper__desc">{paper.data.description}</p>
                <div class="paper__foot">
                  <span class="paper__tags">
                    {paper.data.tags.map((tag) => (
                      <Chip tone="yellow">{tag}</Chip>
                    ))}
                  </span>
                  <span class="paper__go" aria-hidden="true">
                    Read →
                  </span>
                </div>
              </div>
            </HudPanel>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .papers {
    display: grid;
    gap: 22px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .paper {
    position: relative;
    padding: 30px 30px 24px;
  }

  .paper__meta {
    display: flex;
    gap: 8px;
    margin: 0;
    font-family: var(--cy-font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--cy-text-faint);
  }

  .paper__title {
    margin: 10px 0 0;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 700;
    line-height: 1.3;
  }

  .paper__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .paper__title a:hover,
  .paper__title a:focus-visible {
    color: var(--cy-yellow);
  }

  .paper__subtitle {
    margin: 6px 0 0;
    font-family: var(--cy-font-mono);
    font-size: 13px;
    color: var(--cy-yellow);
  }

  .paper__desc {
    max-width: 72ch;
    margin: 14px 0 0;
    color: var(--cy-text-dim);
  }

  .paper__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
  }

  .paper__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .paper__go {
    font-family: var(--cy-font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cy-yellow);
  }
</style>
